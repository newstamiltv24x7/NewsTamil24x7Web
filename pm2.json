{
    "apps": [
      {
        "name": "newstamil_web",
        "script": "server.js",
        "args": "",
        "env": {
          "PORT": "3002",
          "NODE_ENV": "production"
        },
        "node_args": "--max-old-space-size=2048",
        "exec_mode": "cluster_mode",
        "instances": 4,
        "log_file": "server.log",
        "merge_logs": true,
        "wait_ready": true,
        "kill_timeout": 5000,
        "max_memory_restart": "1G",
        "cron_restart": "0 2 * * *",
        "error_file": "logs/error.log",
        "out_file": "logs/out.log"
      }
    ]
  }